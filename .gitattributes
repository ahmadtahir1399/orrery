# Normalize line endings so files consumed inside Linux containers or by
# POSIX shells never pick up CRLF on Windows checkouts (core.autocrlf=true).
* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.husky/*    text eol=lf
.env.example text eol=lf

# Windows-only scripts keep CRLF
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
